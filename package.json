{
  "name": "leeford-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "dev": "concurrently -n api,web -c blue,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc",
    "build:web": "npm --prefix web run build",
    "start": "node dist/server.js",
    "start:web": "npm --prefix web run start",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "eslint src tests",
    "lint:web": "npm --prefix web run lint",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "create-admin:prod": "node dist/scripts/create-admin.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "prettier": "^3.9.7",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0"
  }
}
